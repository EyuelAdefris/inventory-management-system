generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

model User {
  id               String            @id @default(uuid())
  username         String            @unique
  email            String?
  password         String
  name             String
  role             Role              @default(STAFF)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  stockAdjustments StockAdjustment[]
  sales            Sale[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Supplier {
  id            String     @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  products      Product[]
  purchases     Purchase[]

  @@map("suppliers")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@map("customers")
}

model Product {
  id               String            @id @default(uuid())
  name             String
  sku              String            @unique
  description      String?
  categoryId       String
  supplierId       String
  costPrice        Float
  sellingPrice     Float
  stockQuantity    Int               @default(0)
  minStockLevel    Int               @default(5)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchaseItems    PurchaseItem[]
  saleItems        SaleItem[]
  stockAdjustments StockAdjustment[]

  @@map("products")
}

model Purchase {
  id          String         @id @default(uuid())
  supplierId  String
  totalAmount Float
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  supplier    Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items       PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Float
  total      Float
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("purchase_items")
}

model Sale {
  id          String     @id @default(uuid())
  userId      String?
  customerId  String?
  totalAmount Float
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer    Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       SaleItem[]

  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Float
  total     Float
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

model StockAdjustment {
  id             String   @id @default(uuid())
  productId      String
  quantityChange Int
  reason         String
  notes          String?
  userId         String
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("stock_adjustments")
}

enum NotificationType {
  SALE
  PRODUCT_ADD
  PRODUCT_UPDATE
  PRODUCT_DELETE
  STOCK_LOW
}

model Notification {
  id        String           @id @default(uuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

